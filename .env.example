# Postgres connection string. On Railway, adding a PostgreSQL service injects this automatically.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "true" only if your Postgres requires SSL (e.g. an EXTERNAL Railway connection).
# Leave unset/false for Railway's internal private networking.
DATABASE_SSL=false

# Optional shared access key. If set, the app and API require header x-app-key with this value.
# Leave empty for an open (internal-only) instance.
APP_PASSWORD=

# Railway sets PORT automatically; default is 3000 locally.
PORT=3000
